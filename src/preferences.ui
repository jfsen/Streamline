<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <template class="StreamlinePreferences" parent="AdwPreferencesWindow">
    <property name="title" translatable="yes">Preferences</property>
    <property name="modal">True</property>

    <!-- Page 1: Appearance -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">Appearance</property>
        <property name="icon-name">preferences-desktop-appearance-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Window</property>
            <child>
              <object class="AdwComboRow" id="window_size_row">
                <property name="title" translatable="yes">Default Size</property>
                <property name="subtitle" translatable="yes">Choose between the system default or a narrow layout</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">System</item>
                      <item translatable="yes">Narrow</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Theme</property>
            <child>
              <object class="AdwComboRow" id="theme_row">
                <property name="title" translatable="yes">Style</property>
                <property name="subtitle" translatable="yes">Change the application color scheme</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">System</item>
                      <item translatable="yes">Light</item>
                      <item translatable="yes">Dark</item>
                      <item translatable="yes">Bronze</item>
                      <item translatable="yes">Anthracite</item>
                      <item translatable="yes">Red</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- Page 2: Playback -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">Playback</property>
        <property name="icon-name">media-playback-start-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Player</property>
            <child>
              <object class="AdwComboRow" id="player_row">
                <property name="title" translatable="yes">Media Player</property>
                <property name="subtitle" translatable="yes">The video player used to watch streams</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="custom_player_row">
                <property name="title" translatable="yes">Custom Player Command</property>
                <property name="visible">False</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Quality</property>
            <child>
              <object class="AdwComboRow" id="quality_row">
                <property name="title" translatable="yes">Stream Quality</property>
                <property name="subtitle" translatable="yes">Higher quality uses more bandwidth</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="custom_quality_row">
                <property name="title" translatable="yes">Custom Quality</property>
                <property name="visible">False</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="low_latency_switch">
                <property name="title" translatable="yes">Low Latency Mode</property>
                <property name="subtitle" translatable="yes">Reduces stream delay but may cause buffering on slower connections</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Streamers</property>
            <property name="description" translatable="yes">Export your followed streamers list for backup</property>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Export List</property>
                <property name="subtitle" translatable="yes">Save a comma-separated text file</property>
                <child>
                  <object class="GtkButton" id="export_button">
                    <property name="valign">center</property>
                    <property name="icon-name">document-save-symbolic</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- Page 3: Account -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">Account</property>
        <property name="icon-name">user-identification-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Twitch API</property>
            <property name="description" translatable="yes">Credentials are required to fetch stream data. You can get these at dev.twitch.tv/console/apps</property>
            <child>
              <object class="AdwEntryRow" id="client_id_row">
                <property name="title" translatable="yes">Client ID</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="client_secret_row">
                <property name="title" translatable="yes">Client Secret</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>

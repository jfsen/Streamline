<?xml version="1.0" encoding="UTF-8" ?>
<interface>
  <requires lib="gtk" version="4.0" />
  <requires lib="libadwaita" version="1.0" />

  <template class="StreamlinePreferences" parent="AdwPreferencesDialog">
    <property name="title" translatable="yes">Preferences</property>

    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">General</property>
        <property name="icon-name">preferences-system-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Theme</property>
            <child>
              <object class="AdwComboRow" id="theme_row">
                <property name="title" translatable="yes">Style</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >Change the color scheme</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item translatable="yes">System</item>
                      <item translatable="yes">Light</item>
                      <item translatable="yes">Dark</item>
                      <item translatable="yes">Anthracite</item>
                      <item translatable="yes">Justin</item>
                      <item translatable="yes">Oxide</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="profile_pictures_switch">
                <property
                                    name="title"
                                    translatable="yes"
                                >Profile Pictures</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >Show streamer profile pictures on play buttons</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="vod_thumbnails_switch">
                <property
                                    name="title"
                                    translatable="yes"
                                >VOD Thumbnails</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >Show thumbnail previews for VODs as cards</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Player</property>
            <child>
              <object class="AdwComboRow" id="player_row">
                <property
                                    name="title"
                                    translatable="yes"
                                >Media Player</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >The video player used to watch streams</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="custom_player_row">
                <property
                                    name="title"
                                    translatable="yes"
                                >Custom Player Command</property>
                <property name="visible">False</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Quality</property>
            <child>
              <object class="AdwComboRow" id="quality_row">
                <property
                                    name="title"
                                    translatable="yes"
                                >Stream Quality</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >Higher quality uses more bandwidth</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="custom_quality_row">
                <property
                                    name="title"
                                    translatable="yes"
                                >Custom Quality</property>
                <property name="visible">False</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="low_latency_switch">
                <property
                                    name="title"
                                    translatable="yes"
                                >Low Latency Mode</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >Reduces stream delay but may cause buffering on slower connections</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Streamers</property>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Export List</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >Save your followed streamers for backup</property>
                <child>
                  <object class="GtkButton" id="export_button">
                    <property name="valign">center</property>
                    <property name="icon-name">document-save-symbolic</property>
                    <style>
                      <class name="flat" />
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Import List</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >Load a backup file to follow streamers</property>
                <child>
                  <object class="GtkButton" id="import_button">
                    <property name="valign">center</property>
                    <property name="icon-name">document-open-symbolic</property>
                    <style>
                      <class name="flat" />
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Twitch API</property>
            <property
                            name="description"
                            translatable="yes"
                        >Credentials are required to fetch stream data. You can get these at dev.twitch.tv/console/apps</property>
            <child>
              <object class="AdwEntryRow" id="client_id_row">
                <property name="title" translatable="yes">Client ID</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="client_secret_row">
                <property
                                    name="title"
                                    translatable="yes"
                                >Client Secret</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesPage">
        <property name="title" translatable="yes">Chat</property>
        <property name="icon-name">user-available-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">General</property>
            <property
                            name="description"
                            translatable="yes"
                        >Changes apply to newly opened chats</property>
            <child>
              <object class="AdwSwitchRow" id="chat_alternating_bg_switch">
                <property
                                    name="title"
                                    translatable="yes"
                                >Alternating Background</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >Show alternating background colors on chat messages</property>
              </object>
            </child>
            <child>
              <object
                                class="AdwSwitchRow"
                                id="chat_disable_emote_animations_switch"
                            >
                <property
                                    name="title"
                                    translatable="yes"
                                >Disable Emote Animations</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >Use static emote images to reduce resource usage</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="chat_native_engine_switch">
                <property
                                    name="title"
                                    translatable="yes"
                                >Native Chat Engine</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >Use GTK instead of WebKit for chat rendering.  Much lower memory usage, but higher CPU usage for animated emotes</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property
                            name="title"
                            translatable="yes"
                        >Chat Highlighting</property>
            <property
                            name="description"
                            translatable="yes"
                        >Apply tinted backgrounds to certain message types. Changes apply to newly opened chats</property>
            <child>
              <object class="AdwSwitchRow" id="chat_highlight_first_msg_switch">
                <property
                                    name="title"
                                    translatable="yes"
                                >First Messages</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >Blue tint for a user's first message in the channel</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="chat_highlight_mod_switch">
                <property name="title" translatable="yes">Moderators</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >Green tint for messages from moderators</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="chat_highlight_vip_switch">
                <property name="title" translatable="yes">VIPs</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >Pink tint for messages from VIPs</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="chat_highlight_partner_switch">
                <property name="title" translatable="yes">Partners</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >Purple tint for messages from Twitch Partners</property>
              </object>
            </child>
            <child>
              <object
                                class="AdwSwitchRow"
                                id="chat_highlight_broadcaster_switch"
                            >
                <property name="title" translatable="yes">Broadcaster</property>
                <property
                                    name="subtitle"
                                    translatable="yes"
                                >Red tint for messages from the broadcaster</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>

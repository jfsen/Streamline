import os
import sys
import signal
import ctypes
import ctypes.util
import gettext

os.environ['GETTEXT_PACKAGE'] = 'io.github.jfsen.Streamline'

VERSION = '@VERSION@'
pkgdatadir = '@pkgdatadir@'
localedir = '@localedir@'

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)

# Python gettext
gettext.bindtextdomain('io.github.jfsen.Streamline', localedir)
gettext.textdomain('io.github.jfsen.Streamline')
gettext.install('io.github.jfsen.Streamline', localedir)

# C-level gettext (GTK uses dgettext(NULL, ...) for UI templates)
libc = ctypes.CDLL(ctypes.util.find_library('c'))
libc.bindtextdomain(b'io.github.jfsen.Streamline', localedir.encode())
libc.textdomain(b'io.github.jfsen.Streamline')

if __name__ == '__main__':
    import gi

    from gi.repository import Gio
    resource = Gio.Resource.load(os.path.join(pkgdatadir, 'streamline.gresource'))
    resource._register()

    from streamline import main
    sys.exit(main.main(VERSION))

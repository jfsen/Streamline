{
  "id": "io.github.jfsen.Streamline",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "streamline",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--talk-name=org.freedesktop.Flatpak",
    "--persist=.config",
    "--persist=.cache"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "python3-requests",
      "buildsystem": "simple",
      "build-commands": ["pip3 install requests --prefix=/app"]
    },
    {
      "name": "streamline",
      "builddir": true,
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "file:///home/user/Projects",
          "branch": "main"
        },
        {
          "type": "file",
          "path": "data/icons/hicolor/scalable/apps/io.github.jfsen.Streamline.svg"
        },
        {
          "type": "file",
          "path": "data/icons/hicolor/symbolic/apps/io.github.jfsen.Streamline-symbolic.svg"
        }
      ],
      "config-opts": ["--libdir=lib"]
    }
  ],
  "build-options": {
    "env": {},
    "build-args": ["--share=network"]
  }
}

{
  "id": "org.jfsen.Streamline",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "streamline",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "python3-requests",
      "buildsystem": "simple",
      "build-commands": ["pip3 install requests --prefix=/app"]
    },
    {
      "name": "python3-pillow",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install Pillow --prefix=/app --no-build-isolation"
      ],
      "build-options": {
        "build-args": ["--share=network"]
      }
    },
    {
      "name": "streamline",
      "builddir": true,
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ],
      "config-opts": ["--libdir=lib"]
    }
  ],
  "build-options": {
    "env": {},
    "build-args": ["--share=network"]
  }
}

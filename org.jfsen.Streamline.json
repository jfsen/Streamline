{
  "id": "org.jfsen.Streamline",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "streamline",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "python3-deps",
      "buildsystem": "simple",
      "build-commands": [
        "python3 -m pip install --root=/app --prefix='' --ignore-installed lxml",
        "python3 -m pip install --root=/app --prefix='' Pillow requests pycryptodome certifi isodate pycountry PySocks trio trio-websocket urllib3 websocket-client streamlink",
        "python3 -c 'import lxml; print(\"lxml:\", lxml.__version__)'",
        "python3 -c 'import streamlink; print(\"streamlink:\", streamlink.__version__)'"
      ],
      "build-options": {
        "build-args": ["--share=network"]
      }
    },
    {
      "name": "streamline",
      "builddir": true,
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ],
      "config-opts": ["--libdir=lib"]
    }
  ],
  "build-options": {
    "env": {},
    "build-args": ["--share=network"]
  }
}

#: data/org.jfsen.Streamline.desktop.in:3
#: data/org.jfsen.Streamline.metainfo.xml.in:8
msgid "Watch Twitch streams in your local media player"
msgstr "Schaue Twitch-Streams in deinem lokalen Mediaplayer"

#: data/org.jfsen.Streamline.desktop.in:9
msgid "Twitch;Livestream;Streaming;Streamlink;"
msgstr "Twitch;Livestream;Streaming;Streamlink;"

#: data/org.jfsen.Streamline.metainfo.xml.in:11
msgid ""
"Follow your favorite Twitch streamers, check their online status, and watch "
"them in your preferred media player — mpv, VLC, or any custom player. Browse "
"and play channel VODs, all without a web browser."
msgstr ""
"Folge deinen Lieblings-Twitch-Streamern, prüfe ihren Online-Status und "
"schaue sie in deinem bevorzugten Mediaplayer — mpv, VLC oder einem eigenen "
"Player. Rufe Kanal-VODs ab und spiele sie – ganz ohne Webbrowser."


<?xml version="1.0" encoding="UTF-8" ?>
<component type="desktop-application">
  <id>org.jfsen.Streamline</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Streamline</name>
  <summary>Watch Twitch streams in your local media player</summary>
  <description>
    <p
        >Follow your favorite Twitch streamers, check their online status, and watch them in your preferred media player — mpv, VLC, or any custom player. Browse and play channel VODs, all without a web browser.</p>
  </description>

  <developer id="io.github.jfsen">
    <name>jfsen</name>
  </developer>

  <url type="homepage">https://github.com/jfsen/Streamline</url>
  <url type="vcs-browser">https://github.com/jfsen/Streamline</url>
  <url type="bugtracker">https://github.com/jfsen/Streamline/issues</url>

  <translation type="gettext">org.jfsen.Streamline</translation>
  <launchable type="desktop-id">org.jfsen.Streamline.desktop</launchable>

  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>

  <branding>
    <color type="primary" scheme_preference="light">#813d9c</color>
    <color type="primary" scheme_preference="dark">#a669c0</color>
  </branding>

	  <releases>
	    <release version="3.6.0" date="2026-06-27">
	      <description translate="no">
	        <p>Streamline 3.6 — Flatpak bundling, chat rendering overhaul.</p>
	        <ul>
	          <li
                    >Streamlink and all its dependencies are now bundled inside the Flatpak sandbox — no host streamlink or Python packages needed beyond a media player</li>
	          <li
                    >Chat rendering rewritten: Gtk.Label replaces Gtk.TextView for text-only messages, with word-char wrap for cleaner line breaks</li>
	          <li
                    >Emote-only messages laid out in a Gtk.FlowBox for tighter emote display</li>
	          <li
                    >Animated emotes use lazy-decoding via LazyFrames and direct RGBA pixel upload through Gdk.MemoryTexture — no more PNG encode/decode round-trip</li>
	          <li
                    >Periodic garbage collection on chat history culls to reduce memory bloat</li>
	          <li>Translations added for chat system messages</li>
	          <li
                    >Flatpak manifest consolidated into a single python3-deps module with build-time import verification</li>
	          <li
                    >README reorganized — Flatpak install instructions now first, source build second</li>
	        </ul>
	      </description>
	    </release>
	    <release version="3.5.0" date="2026-06-23">
      <description translate="no">
        <p
                >Streamline 3.5 — performance, pagination, and infrastructure cleanup.</p>
        <ul>
          <li
                    >VOD fetch limit increased to 100; displayed 10 at a time with a "Show more…" button to stagger thumbnail downloads</li>
          <li
                    >Broken VOD thumbnail widget ordering fixed when images load asynchronously</li>
          <li
                    >Non-public (subscriber-only) VODs are now filtered out from listings</li>
          <li
                    >Cold-start VOD cache now shows stale data immediately instead of an empty list</li>
          <li
                    >Shared error handler eliminated 70 lines of duplicated exception handling across fetch paths</li>
          <li
                    >Infrastructure constants moved out of config.py to their natural modules (API endpoints, streamlink command, app identity)</li>
          <li
                    >Theme system simplified to a single list of CSS filenames — adding a theme is now a one-line change</li>
          <li
                    >Version string flows from meson.build through to the About dialog — single source of truth</li>
          <li
                    >Removed WebKit chat engine; native GTK chat is now the only option</li>
          <li>Orphaned twitch.css removed; unused callbacks cleaned up</li>
          <li>Updated German translation</li>
        </ul>
      </description>
    </release>
    <release version="3.4.0" date="2026-06-15">
      <description translate="no">
        <p>Streamline 3.4 — polish, consistency, and smarter defaults.</p>
        <ul>
          <li
                    >Chat preferences reorganized into a dedicated Chat page with General and Highlighting groups</li>
          <li
                    >Merged Chat and Detached Chat menu items into a single row with inline detach icon</li>
          <li
                    >VOD thumbnail cache now purges stale images per-streamer on refresh</li>
          <li>Fixed VOD card background bleeding through behind thumbnails</li>
          <li
                    >Fixed dark/light theme detection on the "system" theme setting</li>
          <li>Ctrl+R and F5 merged into a single Keyboard Shortcuts entry</li>
          <li
                    >Online glow and count pill now share the same 3s stay / 2s fade timing</li>
          <li
                    >Row hover uses currentColor for consistent light/dark system theme appearance</li>
          <li
                    >Removed redundant "Stream playback failed" toast when a stream is offline</li>
          <li
                    >Offline streamers with profile pictures no longer show a play-icon overlay or tooltip</li>
          <li
                    >Chat now handles automatic reconnection with proactive keepalive PINGs</li>
          <li
                    >Chat service messages (timeouts, subs, raids) are now parsed and rendered</li>
          <li
                    >Added chat highlighting for user roles (moderators, VIPs, partners, broadcaster)</li>
          <li
                    >Badge SVGs inlined and subscriber tenure added to badge tooltips</li>
          <li
                    >Fixed missing widget realization cleanup when clearing chat messages</li>
          <li>Updated German translation</li>
        </ul>
      </description>
    </release>
    <release version="3.3.0" date="2026-06-11">
      <description translate="no">
        <p
                >Streamline 3.3 — native chat engine, VOD thumbnail cards, and app ID migration.</p>
        <ul>
          <li
                    >Native GTK4 chat engine with animated emotes (BTTV, 7TV, FFZ), now enabled by default</li>
          <li
                    >VOD thumbnail card mode with higher-resolution images and title ellipsizing</li>
          <li>Migrated application ID from io.github.jfsen to org.jfsen</li>
          <li>Profile picture avatars on stream play buttons</li>
          <li>Custom styled group headers replacing plain labels</li>
          <li>Automatic Twitch token refresh on 401 responses</li>
          <li>Improved chat memory usage with deferred message culling</li>
          <li
                    >Expanded README with distro-specific installation instructions</li>
        </ul>
      </description>
    </release>
    <release version="3.2.0" date="2026-05-30">
      <description translate="no">
        <p
                >Streamline 3.2 — infrastructure, polish, and language-agnostic caching.</p>
        <ul>
          <li
                    >Replaced print() debugging with Python logging module across all modules</li>
          <li
                    >Uptime, VOD dates, and durations are now cached as raw values and formatted at display time — survives locale switches</li>
          <li
                    >Fixed app access token expiring every 3.5 hours; now uses the actual ~60 day lifetime from the Twitch API</li>
          <li>Removed deprecated --twitch-disable-ads Streamlink flag</li>
          <li
                    >Simplified cache file structures: merged users.json format, consolidated streams.json</li>
          <li
                    >Cache paths now use GLib.get_user_cache_dir() for proper Flatpak sandbox integration</li>
          <li>Added GPL-3.0 license link to the About dialog</li>
          <li>Removed redundant preferences description strings</li>
        </ul>
      </description>
    </release>
    <release version="3.1.0" date="2026-05-30">
      <description translate="no">
        <p>Streamline 3.1 — German translation.</p>
        <ul>
          <li>German translation</li>
        </ul>
      </description>
    </release>
    <release version="3.0.0" date="2026-05-28">
      <description translate="no">
        <p>Streamline 3.0 — visual polish, responsiveness, and fixes.</p>
        <ul>
          <li
                    >Newly-online streamers get a subtle green glow when they come online after a refresh</li>
          <li
                    >"+N | −N" pill badge on the Online group header shows how many went online or offline</li>
          <li
                    >VOD page loads instantly — spinner appears while VODs fetch in the background</li>
          <li
                    >Custom player paths are now validated before launching; missing players show a clear error</li>
          <li
                    >Custom stream quality no longer forces a "best" fallback, so "audio_only" works as intended</li>
          <li
                    >Fixed separator lines clipping into the left border of streamer rows</li>
          <li>Fixed credentials dialog showing Client Secret in plain text</li>
          <li
                    >Fixed crash on startup when Twitch API credentials are missing</li>
          <li
                    >Debounced config saves in Preferences — no more disk writes on every keystroke</li>
          <li>README now documents Custom stream quality with examples</li>
        </ul>
      </description>
    </release>
    <release version="2.0.0" date="2026-05-20">
      <description translate="no">
        <p>Streamline 2.0 — a major rewrite with new features and polish.</p>
        <ul>
          <li>Migrated settings from JSON file to GSettings backend</li>
          <li
                    >Interactive credential prompt when Twitch API keys are missing or invalid</li>
          <li
                    >Custom theme support: Dark, Light, Bronze, Anthracite, and Red</li>
          <li>VOD browsing and playback via streamlink</li>
          <li>Quick Play for one-off streams without following</li>
          <li>Export streamer list to a text file</li>
          <li>Stream cache with configurable refresh timer</li>
          <li>Low-latency streaming option</li>
          <li>Support for custom player executable paths</li>
          <li>Stream quality presets: High, Medium, Low, and Custom</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2025-01-01">
      <description translate="no">
        <p>Initial prototype release.</p>
        <ul>
          <li>Follow and unfollow streamers</li>
          <li>Online/offline status display</li>
          <li>Stream playback via streamlink with mpv or VLC</li>
          <li>Configurable stream quality</li>
        </ul>
      </description>
    </release>
  </releases>
</component>

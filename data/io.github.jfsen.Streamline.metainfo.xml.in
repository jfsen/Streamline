<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.jfsen.Streamline</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Streamline</name>
  <summary>Watch Twitch streams in your local media player</summary>
  <description>
    <p>Follow your favorite Twitch streamers, check their online status, and watch them in your preferred media player — mpv, VLC, or any custom player. Browse and play channel VODs, all without a web browser.</p>
  </description>

  <developer id="io.github.jfsen">
    <name>jfsen</name>
  </developer>

  <url type="homepage">https://github.com/jfsen/Streamline</url>
  <url type="vcs-browser">https://github.com/jfsen/Streamline</url>
  <url type="bugtracker">https://github.com/jfsen/Streamline/issues</url>

  <translation type="gettext">io.github.jfsen.Streamline</translation>
  <launchable type="desktop-id">io.github.jfsen.Streamline.desktop</launchable>

  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>

  <branding>
    <color type="primary" scheme_preference="light">#813d9c</color>
    <color type="primary" scheme_preference="dark">#a669c0</color>
  </branding>

  <releases>
    <release version="3.2.0" date="2026-05-30">
      <description translate="no">
        <p>Streamline 3.2 — infrastructure, polish, and language-agnostic caching.</p>
        <ul>
          <li>Replaced print() debugging with Python logging module across all modules</li>
          <li>Uptime, VOD dates, and durations are now cached as raw values and formatted at display time — survives locale switches</li>
          <li>Fixed app access token expiring every 3.5 hours; now uses the actual ~60 day lifetime from the Twitch API</li>
          <li>Removed deprecated --twitch-disable-ads Streamlink flag</li>
          <li>Simplified cache file structures: merged users.json format, consolidated streams.json</li>
          <li>Cache paths now use GLib.get_user_cache_dir() for proper Flatpak sandbox integration</li>
          <li>Added GPL-3.0 license link to the About dialog</li>
          <li>Removed redundant preferences description strings</li>
        </ul>
      </description>
    </release>
    <release version="3.1.0" date="2026-05-30">
      <description translate="no">
        <p>Streamline 3.1 — German translation.</p>
        <ul>
          <li>German translation</li>
        </ul>
      </description>
    </release>
    <release version="3.0.0" date="2026-05-28">
      <description translate="no">
        <p>Streamline 3.0 — visual polish, responsiveness, and fixes.</p>
        <ul>
          <li>Newly-online streamers get a subtle green glow when they come online after a refresh</li>
          <li>"+N | −N" pill badge on the Online group header shows how many went online or offline</li>
          <li>VOD page loads instantly — spinner appears while VODs fetch in the background</li>
          <li>Custom player paths are now validated before launching; missing players show a clear error</li>
          <li>Custom stream quality no longer forces a "best" fallback, so "audio_only" works as intended</li>
          <li>Fixed separator lines clipping into the left border of streamer rows</li>
          <li>Fixed credentials dialog showing Client Secret in plain text</li>
          <li>Fixed crash on startup when Twitch API credentials are missing</li>
          <li>Debounced config saves in Preferences — no more disk writes on every keystroke</li>
          <li>README now documents Custom stream quality with examples</li>
        </ul>
      </description>
    </release>
    <release version="2.0.0" date="2026-05-20">
      <description translate="no">
        <p>Streamline 2.0 — a major rewrite with new features and polish.</p>
        <ul>
          <li>Migrated settings from JSON file to GSettings backend</li>
          <li>Interactive credential prompt when Twitch API keys are missing or invalid</li>
          <li>Custom theme support: Dark, Light, Bronze, Anthracite, and Red</li>
          <li>VOD browsing and playback via streamlink</li>
          <li>Quick Play for one-off streams without following</li>
          <li>Export streamer list to a text file</li>
          <li>Stream cache with configurable refresh timer</li>
          <li>Low-latency streaming option</li>
          <li>Support for custom player executable paths</li>
          <li>Stream quality presets: High, Medium, Low, and Custom</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2025-01-01">
      <description translate="no">
        <p>Initial prototype release.</p>
        <ul>
          <li>Follow and unfollow streamers</li>
          <li>Online/offline status display</li>
          <li>Stream playback via streamlink with mpv or VLC</li>
          <li>Configurable stream quality</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
